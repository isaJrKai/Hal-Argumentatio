# Copy to .env for local development and fill in values for your own environment.
# Do not commit .env or use development credentials in production.

# Google Gemini
GEMINI_API_KEY=
APP_URL=

# Optional Google Workspace Firebase web app configuration.
# Leave unset until a real Firebase project and Google provider are configured.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Authentication and encryption: generate unique high-entropy values.
# Generate JWT_SECRET with: openssl rand -hex 32
# Generate a new LEAD_ENCRYPTION_KEY_B64 with: openssl rand -base64 32
# LEAD_ENCRYPTION_KEY_B64 must decode to the key size expected by the application.
# Do not change an existing production encryption key without a data migration plan.
JWT_SECRET=
LEAD_ENCRYPTION_KEY_B64=
# Optional, migration-only old key for re-encrypting existing legacy ciphertext. Keep empty otherwise.
HAL_LEGACY_ENCRYPTION_KEY_B64=

# Optional provider credentials
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=

# Google Maps Platform
GOOGLE_MAPS_PLATFORM_KEY=

# PostgreSQL: configure the connection method used by your deployment.
DATABASE_URL=
NEON_DATABASE_URL=
# Alternative split connection settings, if used by the deployment:
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# AI provider selection (confirm supported values in the implementation)
HAL_ACTIVE_AI=gemini

# Model Context Protocol. Use a unique secret of sufficient entropy.
MCP_SECRET=
# Required when MCP is enabled. Set to the intended account ID; never rely on automatic account discovery.
HAL_MCP_CONTRACTOR_ID=

# Optional outbound provider integrations. Credentials do not prove that a provider is connected.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
SENDGRID_API_KEY=
HAL_SENDER_EMAIL=
HAL_SENDER_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CALENDAR_ID=
CALCOM_BOOKING_URL=
TZ=UTC

# Comma-separated browser origins allowed to call this API cross-origin.
CORS_ALLOWED_ORIGINS=
# Separate high-entropy HMAC key for outbound webhook signing (do not reuse JWT_SECRET).
HAL_WEBHOOK_SIGNING_SECRET=
# Comma-separated exact hostnames allowed for outbound signed webhooks (HTTPS only).
HAL_WEBHOOK_ALLOWED_HOSTS=
# Meta WhatsApp Cloud API app secret used to verify inbound X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# Inbound CRM webhook shared secret (16+ chars). The endpoint is disabled until this is set.
HAL_CRM_WEBHOOK_SECRET=
